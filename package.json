{
  "name": "chat-bot",
  "version": "0.2.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller": false
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-timeout=30000 test/*.test.mjs",
    "start": "node dist/cli.js",
    "gemini:verify": "node dist/verify-gemini.js",
    "antigravity:verify": "node dist/verify-antigravity.js",
    "web:build": "tsc && tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "web:start": "node dist/web-server.js",
    "web:setup": "node scripts/setup-web.mjs",
    "desktop:prepare": "node scripts/install-desktop-electron.mjs && npm run web:build && node scripts/create-desktop-icon.mjs && node scripts/prepare-desktop.mjs",
    "desktop:start": "electron desktop-app",
    "desktop:pack": "npm run desktop:prepare && node scripts/build-desktop.mjs",
    "release:export": "node scripts/export-release.mjs",
    "release:privacy": "node scripts/release-privacy.mjs",
    "release:guardian": "node scripts/release-guardian.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "secrets:migrate": "node scripts/migrate-secrets.mjs",
    "source:audit": "node scripts/audit-source-licenses.mjs",
    "source:check": "node scripts/source-publication-gate.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "fastify": "5.12.7",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "1.63.0",
    "mammoth": "1.13.0",
    "motion": "14.7.1",
    "pdfjs-dist": "6.4.299",
    "proxy-agent": "6.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "jszip": "3.10.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "basic-ftp": "6.2.1",
    "glob": "14.0.3"
  }
}
